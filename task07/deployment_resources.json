{
  "lambda-basic-execution": {
    "policy_content": {
      "Statement": [
        {
          "Action": [
            "logs:CreateLogGroup",
            "logs:CreateLogStream",
            "logs:PutLogEvents",
            "dynamodb:GetItem",
            "dynamodb:Query",
            "dynamodb:PutItem",
            "dynamodb:Batch*",
            "dynamodb:DeleteItem",
            "ssm:PutParameter",
            "ssm:GetParameter",
            "kms:Decrypt"
          ],
          "Effect": "Allow",
          "Resource": "*"
        }
      ],
      "Version": "2012-10-17"
    },
    "resource_type": "iam_policy",
    "tags": {}
  },
  "Events": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "id",
    "hash_key_type": "S",
    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 1,
    "write_capacity": 1,
    "max_read_capacity": 1,
    "max_write_capacity": 1,
    "global_indexes": [],
    "autoscaling": [],
    "tags": {}
  },
  "appsync-dynamodb-policy": {
    "resource_type": "iam_policy",
    "policy_content": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "dynamodb:PutItem",
            "dynamodb:GetItem",
            "dynamodb:UpdateItem",
            "dynamodb:DeleteItem",
            "dynamodb:Query",
            "dynamodb:Scan"
          ],
          "Resource": "*"
        }
      ]
    }
  },
  "appsync-dynamodb-role": {
    "resource_type": "iam_role",
    "principal_service": "appsync",
    "predefined_policies": [],
    "custom_policies": [
      "appsync-dynamodb-policy"
    ],
    "allowed_accounts": [],
    "instance_profile": false,
    "permissions_boundary": "",
    "tags": {}
  },
  "GraphQL_API": {
    "resource_type": "appsync",
    "primary_auth_type": "API_KEY",
    "schema_path": "schema.graphql",
    "deployment_package": "task07.zip",
    "data_sources": [
      {
        "name": "EventsDataSource",
        "type": "AMAZON_DYNAMODB",
        "dynamodb_config": {
          "table_name": "Events",
          "aws_region": "us-east-1",
          "use_caller_credentials": false,
          "versioned": false
        },
        "service_role_name": "appsync-dynamodb-role"
      }
    ],
    "resolvers": [
      {
        "type_name": "Mutation",
        "field_name": "createEvent",
        "data_source_name": "EventsDataSource",
        "runtime": "APPSYNC_JS",
        "code_path": "createEventResolver.js"
      },
      {
        "type_name": "Query",
        "field_name": "getEvent",
        "data_source_name": "EventsDataSource",
        "runtime": "APPSYNC_JS",
        "code_path": "getEventResolver.js"
      }
    ]
  }
}