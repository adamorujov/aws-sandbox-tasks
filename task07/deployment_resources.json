{
  "lambda-basic-execution": {
    "policy_content": {
      "Statement": [
        {
          "Action": [
            "logs:CreateLogGroup",
            "logs:CreateLogStream",
            "logs:PutLogEvents",
            "dynamodb:GetItem",
            "dynamodb:Query",
            "dynamodb:PutItem",
            "dynamodb:Batch*",
            "dynamodb:DeleteItem",
            "ssm:PutParameter",
            "ssm:GetParameter",
            "kms:Decrypt"
          ],
          "Effect": "Allow",
          "Resource": "*"
        }
      ],
      "Version": "2012-10-17"
    },
    "resource_type": "iam_policy",
    "tags": {}
  },
  "Events": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "id",
    "hash_key_type": "S",
    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 1,
    "write_capacity": 1,
    "max_read_capacity": 1,
    "max_write_capacity": 1,
    "global_indexes": [],
    "autoscaling": [],
    "tags": {}
  },
  "appsync_role": {
    "resource_type": "iam_role",
    "principal_service": "appsync",
    "predefined_policies": [
        "lambda-basic-execution"
    ],
    "custom_policies": [],
    "allowed_accounts": ["${account_id}"],
    "instance_profile": false,
    "permissions_boundary": "",
    "tags": {}
  },
  "GraphQL_API": {
    "resource_type": "appsync",
    "primary_auth_type": "API_KEY",
    "api_key_expiration_days": 365,
    "schema_path": "graphql_schema.graphql",
    "deployment_package": "GraphQL_API.zip",
    "data_sources": [
        {
            "name": "EventsTableDataSource",
            "type": "AMAZON_DYNAMODB",
            "service_role_name": "appsync_role",
            "dynamodb_config": {
                "table_name": "Events",
                "aws_region": "eu-west-1"
            }
        }
    ],
    "resolvers": [
        {
            "type_name": "Mutation",
            "field_name": "createEvent",
            "runtime": "APPSYNC_JS",
            "data_source_name": "EventsTableDataSource",
            "code": "import { util } from '@aws-appsync/utils';\nimport { put } from '@aws-appsync/utils/dynamodb';\nexport function request(ctx) {\n  const id = util.autoId();\n  const createdAt = util.time.nowISO8601();\n  return put({\n    key: { id },\n    item: {\n      userId: ctx.arguments.userId,\n      createdAt: createdAt,\n      payLoad: ctx.arguments.payLoad\n    }\n  });\n}\nexport function response(ctx) {\n  if (ctx.error) { util.error(ctx.error.message, ctx.error.type); }\n  return ctx.result;\n}"
        },
        {
            "type_name": "Query",
            "field_name": "getEvent",
            "runtime": "APPSYNC_JS",
            "data_source_name": "EventsTableDataSource",
            "code": "import { util } from '@aws-appsync/utils';\nimport { get } from '@aws-appsync/utils/dynamodb';\nexport function request(ctx) {\n  return get({ key: { id: ctx.arguments.id } });\n}\nexport function response(ctx) {\n  if (ctx.error) { util.error(ctx.error.message, ctx.error.type); }\n  return ctx.result;\n}"
        }
    ],
    "tags": {}
  }
}
